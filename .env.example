# OpenAI - tylko do lokalnego devu.
# Na BTP klucza NIE ustawiamy tutaj ani jako binding - trzyma go Destination "OPENAI".
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# opcjonalnie: własny endpoint / gateway
# OPENAI_BASE_URL=https://api.openai.com/v1
# opcjonalnie: inna nazwa destynacji z kluczem (domyślnie OPENAI)
# OPENAI_DESTINATION=OPENAI
# opcjonalnie: proxy firmowe (gdy "Premature close" / brak połączenia)
# HTTPS_PROXY=http://proxy.firma.local:8080

# Backend Business Partner service
BP_DESTINATION=SA1_300
# Ustaw na true, aby testować lokalnie bez destinacji (dane z mocka):
BP_MOCK=false

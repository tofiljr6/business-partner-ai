# Skopiuj do .env (jest w .gitignore). CAP (cds watch) laduje .env automatycznie.

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# opcjonalnie: wlasny endpoint / gateway
# OPENAI_BASE_URL=https://api.openai.com/v1
# opcjonalnie: proxy firmowe (gdy "Premature close" / brak polaczenia)
# HTTPS_PROXY=http://proxy.firma.local:8080

# ---------- Backend Business Partner (destynacja) ----------
BP_DESTINATION=SA1_300

# Najprosciej lokalnie: true = nie wolaj SAP, uzyj danych z mocka (srv/lib/bpClient.js)
BP_MOCK=false

# Zeby lokalnie wolac PRAWDZIWY system przez getDestination('SA1_300'),
# Cloud SDK czyta zmienna `destinations` (tablica JSON, jedna linia):
# destinations=[{"name":"SA1_300","url":"https://host:44300","username":"USER","password":"PASS"}]
#
# Alternatywa (symulacja CF): plik default-env.json w katalogu projektu
# z pelnym VCAP_SERVICES + VCAP_APPLICATION - wtedy SDK robi realny
# lookup uslugi destination. Oba pliki (.env, default-env.json) sa w .gitignore.
